# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# ---- Contact form -------------------------------------------------------
# Enquiries are emailed via Resend (the jewelps.co.uk domain is verified there).
# Get the key from the Resend dashboard → API keys. Without it, no email is sent
# (the enquiry is still stored in Supabase when that is configured).
RESEND_API_KEY=
# Optional overrides. FROM must be on the verified domain.
CONTACT_TO_EMAIL=enquiries@jewelps.co.uk
CONTACT_FROM_EMAIL=website@jewelps.co.uk
# Optional extra: also post each enquiry as JSON to a webhook (e.g. an n8n Webhook node URL).
FORM_WEBHOOK_URL=
# Optional shared secret, sent as the `x-jewel-secret` header so your workflow can verify the source.
FORM_WEBHOOK_SECRET=

# ---- Admin area (/admin) ------------------------------------------------
# Supabase project → Settings → API. The service_role key bypasses RLS — server only, never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Login for /admin. Choose your own values; the site compares login attempts against these.
# Use a long, unique password — the login is rate-limited (5 failed attempts per IP in
# 15 minutes) but the password is still the main lock.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secret for signing the login cookie: any long random string, e.g. the output of
# `openssl rand -base64 32`. Falls back to ADMIN_PASSWORD if unset, but set it —
# changing it also signs every admin out at once.
ADMIN_SESSION_SECRET=

# ---- Brochure PDF generation --------------------------------------------
# Optional. Locally the site finds an installed Chrome/Chromium on its own (and on
# Vercel @sparticuz/chromium is bundled); set this only to point at a specific binary.
PDF_CHROME_PATH=

# ---- Images -------------------------------------------------------------
# Where photography is served from. The library lives in static/images/photos, so
# set this to /images/photos (locally and on Vercel) to self-host.
VITE_IMG_BASE=/images/photos
